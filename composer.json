{
  "name": "maatify/php-persistence",
  "description": "PDO persistence utilities for MySQL and MariaDB, in development.",
  "keywords": [
    "persistence",
    "pdo",
    "mysql",
    "mariadb",
    "php",
    "maatify"
  ],
  "homepage": "https://github.com/Maatify/php-persistence",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Maatify",
      "email": "support@maatify.dev",
      "homepage": "https://maatify.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/Maatify/php-persistence/issues",
    "source": "https://github.com/Maatify/php-persistence"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\PhpPersistence\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\PhpPersistence\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "maatify/exceptions": "^1.0",
    "php": "^8.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "format": "php-cs-fixer fix",
    "format:check": [
      "php-cs-fixer fix --dry-run --diff",
      "@php scripts/check-per-cs-3-1.php"
    ],
    "syntax": "find src tests scripts examples .php-cs-fixer.php -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
    "whitespace": "git diff --check 4b825dc642cb6eb9a060e54bf8d69288fbee4904 HEAD -- . ':!docs/php-engineering-standards'",
    "test": [
      "@test:unit",
      "@test:regression",
      "@test:integration"
    ],
    "test:unit": "phpunit --testsuite unit",
    "test:regression": "phpunit --testsuite regression",
    "test:integration": "@php scripts/integration.php",
    "examples:smoke": "@php scripts/examples-smoke.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    },
    "policy": {
      "advisories": {
        "block": true,
        "audit": "fail"
      },
      "malware": {
        "block": true,
        "block-scope": "all",
        "audit": "fail"
      },
      "abandoned": {
        "audit": "fail"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
