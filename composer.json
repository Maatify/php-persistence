{
  "name": "maatify/php-persistence",
  "description": "PDO persistence utilities for MySQL and MariaDB, in development.",
  "keywords": [
    "persistence",
    "pdo",
    "mysql",
    "mariadb",
    "php",
    "maatify"
  ],
  "homepage": "https://github.com/Maatify/php-persistence",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Maatify",
      "email": "support@maatify.dev",
      "homepage": "https://maatify.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/Maatify/php-persistence/issues",
    "source": "https://github.com/Maatify/php-persistence"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\PhpPersistence\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\PhpPersistence\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "maatify/exceptions": "^1.0",
    "php": "^8.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress",
    "format": "php-cs-fixer fix",
    "format:check": [
      "php-cs-fixer fix --dry-run --diff",
      "@php scripts/check-per-cs-3-1.php"
    ],
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:regression": "phpunit --testsuite regression"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
